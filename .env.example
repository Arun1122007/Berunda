# ── Application Environment ─────────────────────────────────────
# Options: development, test, staging, production
APP_ENV=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# Comma-separated CORS origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# ── Database ──────────────────────────────────────────────────
# SQLite for local dev; PostgreSQL in production
DATABASE_URL=sqlite+aiosqlite:///./berunda.db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Read-replica (optional — falls back to primary if unset)
# READ_DATABASE_URL=postgresql+asyncpg://readonly:password@replica-host:5432/berunda

# ── Auth & JWT ─────────────────────────────────────────────────
# ⚠ Replace with a cryptographically random 256-bit key in production:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-a-random-64-hex-char-string
ACCESS_TOKEN_EXPIRY_MINUTES=60
REFRESH_TOKEN_EXPIRY_DAYS=7

# ── Celery / Background Tasks ─────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ── Redis Cache (separate from Celery broker) ─────────────────
REDIS_URL=redis://localhost:6379/1
CACHE_TTL_SECONDS=300

# ── AI Providers ──────────────────────────────────────────────
# OpenAI (required for embeddings)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Groq (optional, used as fallback provider)
GROQ_API_KEY=

# Zoho Catalyst (enterprise AI features)
CATALYST_PROJECT_ID=
CATALYST_API_KEY=

# ── AI Retry Settings ─────────────────────────────────────────
AI_MAX_RETRIES=3
AI_RETRY_DELAY=2.0

# ── Neo4j Graph Database (optional) ───────────────────────────
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# ── Testing ───────────────────────────────────────────────────
TEST_DATABASE_URL=
TEST_CACHE_URL=redis://localhost:6379/0
AUTH_JWT_SECRET=test-secret-not-for-production

# ── Database Seed / Migrations ────────────────────────────────
INITIAL_ADMIN_PASSWORD=admin123
INITIAL_ANALYST_PASSWORD=analyst123

# ── Frontend (Vite) ───────────────────────────────────────────
VITE_API_BASE_URL=/api/v1
VITE_API_URL=http://localhost:8000

# ── Docker Production Overrides ───────────────────────────────
# These are required by docker-compose.prod.yml
# DB_PASSWORD=
# REDIS_PASSWORD=
# CORS_ORIGINS=

# ── Catalyst Specific Additions ───────────────────────────────
FRONTEND_BASE_URL=http://localhost:3000
STRATUS_DATA_BUCKET=berunda-data
STRATUS_ARTIFACT_BUCKET=berunda-artifacts
STRATUS_REPORT_BUCKET=berunda-reports
INTERNAL_JOB_SECRET=your_secure_secret_here
AI_PROVIDER=catalyst
