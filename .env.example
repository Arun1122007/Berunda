# Project Berunda — Environment Configuration
# Version: 1.0 | Last updated: 2026-07-18
# Copy to .env and fill in values (never commit .env)

# --- Catalyst Configuration ---
CATALYST_PROJECT_ID=your_project_id_here
CATALYST_CLIENT_ID=your_client_id_here
CATALYST_CLIENT_SECRET=your_client_secret_here
CATALYST_REFRESH_TOKEN=your_refresh_token_here
CATALYST_ENVIRONMENT=development

# --- API Keys ---
OPEN_METEO_API_KEY=          # Optional; rate-limited free tier available
BHUVAN_API_KEY=              # May be required for some Bhuvan layers

# --- Workspace ---
WORKSPACE_ROOT=D:\Hack2Skill\Berunda
SYNTHETIC_DATA_SEED=42
LOG_LEVEL=INFO

# --- Resource Acquisition ---
DRY_RUN=true                 # Safety: default to dry-run
MAX_FILE_SIZE=209715200      # 200 MB default
MAX_TOTAL_SIZE=1073741824    # 1 GB default
