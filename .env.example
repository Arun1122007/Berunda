# ── Application Environment ─────────────────────────────────────
# Options: development, test, staging, production
APP_ENV=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# Comma-separated CORS origins
CORS_ORIGINS=http://localhost:5173,http://localhost:8000,https://catalyst.zoho.in

# ── Database ──────────────────────────────────────────────────
# Local dev uses SQLite via SQLAlchemy.
# Staging/Production uses Catalyst Data Store natively (ignoring DATABASE_URL).
DATABASE_URL=sqlite+aiosqlite:///./berunda.db

# Enable to force Catalyst repository usage locally (requires zcatalyst_sdk credentials)
USE_CATALYST=false

# ── Auth & JWT ─────────────────────────────────────────────────
JWT_SECRET=replace-with-a-random-64-hex-char-string
ACCESS_TOKEN_EXPIRY_MINUTES=60
REFRESH_TOKEN_EXPIRY_DAYS=7

# ── AI Providers ──────────────────────────────────────────────
# Default provider should be catalyst in production
DEFAULT_AI_PROVIDER=catalyst
# Fallback provider if running outside Catalyst ecosystem
OPENAI_API_KEY=

# ── Catalyst Specific Config ───────────────────────────────
FRONTEND_BASE_URL=http://localhost:5173
STRATUS_DATA_BUCKET=berunda-data
STRATUS_ARTIFACT_BUCKET=berunda-artifacts
STRATUS_REPORT_BUCKET=berunda-reports
INTERNAL_JOB_SECRET=your_secure_secret_here

# ── Frontend (Vite) ───────────────────────────────────────────
VITE_API_BASE_URL=/api/v1
VITE_API_URL=http://localhost:8000
