# =====================================================================
# Project Berunda — Local Development Environment Variables (.env.example)
#
# DO NOT ADD REAL SECRETS TO THIS FILE. 
# Copy this file to `.env` and fill in the placeholders for local development.
# =====================================================================

# ── Application Environment ─────────────────────────────────────
# Options: development, test, staging, production
# Purpose: Determines which configuration settings are used and debug options.
APP_ENV=development

# Options: DEBUG, INFO, WARNING, ERROR
# Purpose: Granularity of backend logging.
LOG_LEVEL=DEBUG

# Purpose: Backend listener configuration
HOST=0.0.0.0
PORT=9000

# ── Database ──────────────────────────────────────────────────
# Local dev uses SQLite via SQLAlchemy.
# Staging/Production uses Catalyst Data Store natively.
# Format: driver://user:pass@host/dbname
DATABASE_URL=sqlite+aiosqlite:///./src/berunda.db

# Enable to force Catalyst repository usage locally (requires zcatalyst_sdk credentials)
USE_CATALYST=false

# ── Auth & JWT ─────────────────────────────────────────────────
# Secret used for signing JWT access and refresh tokens.
# WARNING: MUST be at least 256-bit (64 hex characters) in production.
JWT_SECRET_KEY=replace-with-a-random-64-hex-char-string

# Token expiry limits
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Security & CORS ───────────────────────────────────────────
# Comma-separated CORS origins
# E.g. http://localhost:5173,https://catalyst.zoho.in
CORS_ORIGINS=http://localhost:5173,http://localhost:9000

# ── AI Providers ──────────────────────────────────────────────
# Default provider should be mock for local development and catalyst/openai in production
DEFAULT_AI_PROVIDER=mock

# Fallback provider if running outside Catalyst ecosystem
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# ── Catalyst Specific Config ───────────────────────────────
FRONTEND_BASE_URL=http://localhost:5173

# Stratus File Storage configuration for file uploads
STRATUS_TOKEN=your_stratus_api_token
STRATUS_BUCKET=berunda-dev-docs

# Internal job secret for executing cron-based risk batches
INTERNAL_JOB_SECRET=your_secure_secret_here

# ── Frontend (Vite) ───────────────────────────────────────────
# Used in the frontend build `apps/web/.env`
VITE_API_BASE_URL=http://localhost:9000/api/v1
