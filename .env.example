# =====================================================================
# Project Berunda — Local Development Environment Variables (.env.example)
# =====================================================================

# ── Application Environment ─────────────────────────────────────
APP_ENV=development
LOG_LEVEL=DEBUG
HOST=0.0.0.0
PORT=9000

# ── Database Options ───────────────────────────────────────────
# Option 1 (Active Default — Recommended for Hackathon): Bundled SQLite (40,823 seeded FIR records)
DATABASE_URL=sqlite+aiosqlite:///./berunda.db

# Option 2 (Remote PostgreSQL / Neon / Supabase / AWS RDS):
# DATABASE_URL=postgresql+asyncpg://postgres:your_password@ep-your-db-host.neon.tech:5432/berundadb

# Option 3 (Zoho Catalyst Data Store ZCQL):
# Set USE_CATALYST=true to route queries via Catalyst Data Store ZCQL adapter
USE_CATALYST=false

# ── Auth & JWT ─────────────────────────────────────────────────
JWT_SECRET=replace-with-a-random-64-hex-char-string
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Security & CORS ───────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:9000,https://project-rainfall-60079736152.development.catalystserverless.in

# ── Celery / Remote Redis / Upstash / Background Tasks ─────────
REDIS_URL=rediss://default:your_upstash_redis_password@your-upstash-redis.upstash.io:6379/0
CELERY_BROKER_URL=rediss://default:your_upstash_redis_password@your-upstash-redis.upstash.io:6379/0
CELERY_RESULT_BACKEND=rediss://default:your_upstash_redis_password@your-upstash-redis.upstash.io:6379/0

# ── AI Providers & Multi-Provider Fallback Chain ──────────────
DEFAULT_AI_PROVIDER=fallback

GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1

NVIDIA_API_KEY=nvapi-your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

OPENAI_API_KEY=sk-proj-your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1

CATALYST_API_KEY=your_catalyst_api_key_here

# ── Catalyst Specific Config ───────────────────────────────
FRONTEND_BASE_URL=https://project-rainfall-60079736152.development.catalystserverless.in/app/index.html
CATALYST_PROJECT_ID=48591000000013025
CATALYST_PROJECT_DOMAIN=project-rainfall-60079736152.development.catalystserverless.in
CATALYST_ENVIRONMENT_ID=60079736152
CATALYST_ENVIRONMENT=Development

# ── Stratus File Storage & Uploads ────────────────────────────
STRATUS_TOKEN=your_stratus_api_token
STRATUS_BUCKET=berunda-dev-docs
STRATUS_ENABLED=false
MAX_UPLOAD_SIZE_MB=25
ALLOWED_FILE_TYPES=application/pdf,image/jpeg,image/png,text/plain

# ── Feature Flags & Mock Services ─────────────────────────────
ENABLE_AI_REVIEW=true
ENABLE_MOCK_AUTH=false
USE_MOCK_SERVICES=false
MOCK_AUTH_ENABLED=false

INTERNAL_JOB_SECRET=your_secure_secret_here

# ── Frontend (Vite) ───────────────────────────────────────────
VITE_API_BASE_URL=https://berunda-api-50044292022.development.catalystappsail.in/api/v1
VITE_API_URL=https://berunda-api-50044292022.development.catalystappsail.in
VITE_CATALYST_ENABLED=true
VITE_APP_ENV=production
