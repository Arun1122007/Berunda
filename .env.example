# ── Database ──────────────────────────────────────────────────
# Default to SQLite for local dev or use PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/berunda
DATABASE_URL=sqlite+aiosqlite:///./berunda.db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ── Auth & Security ───────────────────────────────────────────
JWT_SECRET=super-secret-key-change-in-production
JWT_EXPIRY_HOURS=24
LOG_LEVEL=INFO

# ── AI Providers ──────────────────────────────────────────────
# OpenAI (Required for embeddings in MVP)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1

# Groq (Optional, alternative provider)
GROQ_API_KEY=your_groq_api_key_here

# Catalyst (Zoho) (Optional, for enterprise features)
CATALYST_API_KEY=your_catalyst_key_here
CATALYST_PROJECT_ID=your_catalyst_project_id_here
