# =============================================================================
# Berunda - Production Environment
# =============================================================================
# Most values are set in Catalyst Console.
# This file contains only safe defaults and documentation.
# =============================================================================

# Application
APP_NAME=berunda
APP_ENV=production
APP_DEBUG=false
APP_PORT=9000
APP_HOST=0.0.0.0
LOG_LEVEL=warn
LOG_FORMAT=json

# Catalyst
CATALYST_ENV=production

# Database
DB_TYPE=datastore
DB_ECHO=false

# Cache
CACHE_TYPE=stratus
CACHE_TTL=600

# Authentication
AUTH_PROVIDER=catalyst
AUTH_JWT_EXPIRY=1h
AUTH_JWT_ISSUER=berunda

# AI / ML
AI_PROVIDER=catalyst
AI_MAX_TOKENS=8192
AI_TEMPERATURE=0.5

# Entity Resolution
ER_SIMILARITY_THRESHOLD=0.90
ER_MAX_CANDIDATES=200
ER_BATCH_SIZE=500

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60

# Pagination
PAGINATION_DEFAULT_PAGE=1
PAGINATION_DEFAULT_LIMIT=20
PAGINATION_MAX_LIMIT=100

# CORS
# Set in Catalyst Console

# Monitoring
SENTRY_TRACES_SAMPLE_RATE=0.1
