# =============================================================================
# Berunda - Staging Environment
# =============================================================================
# Copy to staging.env and customize
# =============================================================================

# Application
APP_NAME=berunda
APP_ENV=staging
APP_DEBUG=false
APP_PORT=9000
APP_HOST=0.0.0.0
LOG_LEVEL=info
LOG_FORMAT=json

# Catalyst
CATALYST_ENV=staging
CATALYST_PROJECT_ID=
CATALYST_CLIENT_ID=
CATALYST_CLIENT_SECRET=

# Database
DB_TYPE=datastore
DB_ECHO=false

# DataStore
DATASTORE_TABLE_PREFIX=stg_

# Cache (Stratus)
CACHE_TYPE=stratus
CACHE_TTL=300
STRATUS_HOST=
STRATUS_PORT=6379

# Authentication
AUTH_PROVIDER=catalyst
AUTH_JWT_EXPIRY=2h
AUTH_JWT_ISSUER=berunda-staging

# AI / ML
AI_PROVIDER=catalyst
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.7

# Entity Resolution
ER_SIMILARITY_THRESHOLD=0.85
ER_MAX_CANDIDATES=100
ER_BATCH_SIZE=200

# External APIs
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
DATA_GOV_API_KEY=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=200

# Pagination
PAGINATION_DEFAULT_PAGE=1
PAGINATION_DEFAULT_LIMIT=20
PAGINATION_MAX_LIMIT=100

# CORS
CORS_ORIGINS=https://staging.berunda.hack2skill.com

# Monitoring
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.5

# Worker
WORKER_CONCURRENCY=4
WORKER_POLL_INTERVAL=5000
WORKER_HEALTH_FILE=/tmp/worker-health
