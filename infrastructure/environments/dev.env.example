# =============================================================================
# Berunda - Development Environment
# =============================================================================
# Copy to dev.env and customize
# =============================================================================

# Application
APP_NAME=berunda
APP_ENV=development
APP_DEBUG=true
APP_PORT=9000
APP_HOST=0.0.0.0
LOG_LEVEL=debug
LOG_FORMAT=pretty

# Catalyst
CATALYST_ENV=development
CATALYST_PROJECT_ID=
CATALYST_CLIENT_ID=
CATALYST_CLIENT_SECRET=

# Database
DB_TYPE=sqlite
DB_PATH=./data/berunda_dev.db
DB_ECHO=true

# DataStore (when using Catalyst DataStore)
DATASTORE_TABLE_PREFIX=dev_

# Cache (Stratus / Redis)
CACHE_TYPE=memory
CACHE_TTL=300
STRATUS_HOST=localhost
STRATUS_PORT=6379

# Authentication
AUTH_PROVIDER=mock
AUTH_JWT_SECRET=dev-secret-change-in-production
AUTH_JWT_EXPIRY=24h
AUTH_JWT_ISSUER=berunda-dev

# AI / ML
AI_PROVIDER=mock
AI_MODEL_PATH=./models/
AI_EMBEDDING_DIM=384
AI_MAX_TOKENS=2048
AI_TEMPERATURE=0.7
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Entity Resolution
ER_SIMILARITY_THRESHOLD=0.85
ER_MAX_CANDIDATES=50
ER_BATCH_SIZE=100

# Polygon Mapping
POLYGON_CACHE_DIR=./data/polygons/
POLYGON_OVERPASS_URL=https://overpass-api.de/api/interpreter

# External APIs
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
DATA_GOV_API_KEY=
NCRB_DATA_DIR=./data/ncrb/

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Pagination
PAGINATION_DEFAULT_PAGE=1
PAGINATION_DEFAULT_LIMIT=20
PAGINATION_MAX_LIMIT=100

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# WebSocket
WS_HEARTBEAT_INTERVAL=30000
WS_HEARTBEAT_TIMEOUT=10000

# Monitoring
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0

# Worker
WORKER_CONCURRENCY=4
WORKER_POLL_INTERVAL=5000
WORKER_HEALTH_FILE=/tmp/worker-health
