# ── Secrets (MUST replace before production deploy) ─────────
DB_PASSWORD=change-me-32-char-min
JWT_SECRET=change-me-64-char-min
REDIS_PASSWORD=change-me-16-char-min

# ── API Configuration ────────────────────────────────────────
APP_ENV=production
LOG_LEVEL=WARNING
CORS_ORIGINS=https://berunda.example.com,https://admin.berunda.example.com

# ── Celery ────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
CELERY_RESULT_BACKEND=redis://:${REDIS_PASSWORD}@redis:6379/0
