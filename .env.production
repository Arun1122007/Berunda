# ── Secrets (MUST replace before production deploy) ─────────
DB_PASSWORD=change-me-32-char-min
JWT_SECRET=change-me-64-char-min
REDIS_PASSWORD=change-me-16-char-min

# ── API Configuration ────────────────────────────────────────
APP_ENV=production
LOG_LEVEL=WARNING
CORS_ORIGINS=https://berunda.example.com,https://admin.berunda.example.com
HOST=0.0.0.0
PORT=8000

# ── Database ──────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:${DB_PASSWORD}@db:5432/berunda
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40

# Read-replica (optional — falls back to primary if unset)
# READ_DATABASE_URL=postgresql+asyncpg://readonly:${DB_PASSWORD}@replica:5432/berunda

# ── Auth & JWT ─────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRY_MINUTES=30
REFRESH_TOKEN_EXPIRY_DAYS=7

# ── Celery ────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
CELERY_RESULT_BACKEND=redis://:${REDIS_PASSWORD}@redis:6379/0

# ── Redis Cache ───────────────────────────────────────────────
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/1
CACHE_TTL_SECONDS=300

# ── AI Providers ──────────────────────────────────────────────
OPENAI_API_KEY=
GROQ_API_KEY=
CATALYST_PROJECT_ID=
CATALYST_API_KEY=

# ── AI Retry ──────────────────────────────────────────────────
AI_MAX_RETRIES=3
AI_RETRY_DELAY=2.0

# ── Neo4j (optional) ──────────────────────────────────────────
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# ── Logging ───────────────────────────────────────────────────
LOG_DIR=/var/log/berunda
