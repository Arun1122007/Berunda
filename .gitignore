# ============================================================
# Project Berunda — .gitignore
# Per Blueprint Section G: keep the public repo limited to
# code, schemas, and small samples.
# ============================================================

# ── Environment & secrets ────────────────────────────────────
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx
*.crt
credentials.json
token.json
catalyst-credentials.json
service-account.json

# ── Data directories (large / sensitive) ─────────────────────
data/raw/
data/external/
data/synthetic/
data/interim/
data/processed/
data/samples/
data/restricted-placeholders/
data/organizer/

# Keep .gitkeep files so directory structure is preserved
!data/**/.gitkeep

# ── Quarantine (untrusted downloads) ─────────────────────────
quarantine/
!quarantine/.gitkeep

# ── Cloned repositories ─────────────────────────────────────
repositories/
!repositories/.gitkeep

# ── Models (trained / downloaded) ────────────────────────────
models/
!models/.gitkeep
*.h5
*.pkl
*.joblib
*.pt
*.onnx

# ── Boundaries (geospatial layers) ───────────────────────────
boundaries/
!boundaries/.gitkeep

# ── Logs ─────────────────────────────────────────────────────
logs/*.log
!logs/.gitkeep

# ── Downloaded resources ─────────────────────────────────────
resources/source-pages/
resources/papers/
!resources/**/.gitkeep

# ── Migration backup ─────────────────────────────────────────
_migration_backup*/

# ── Build output ─────────────────────────────────────────────
dist/
build/
*.tsbuildinfo

# ── Python ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
dist/
build/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage/
htmlcov/

# ── Node.js ──────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.cache/

# ── Java ─────────────────────────────────────────────────────
*.class
*.jar
*.war
target/

# ── IDE / Editor ─────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.opencode/

# ── OS files ─────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# ── Large data formats (safety net) ──────────────────────────
*.parquet
*.db
*.sqlite
*.sqlite3
*.hdf5
*.h5
*.feather
*.arrow
*.zip
*.tar.gz
*.tgz
*.7z
*.geojson
*.shp

# ── Checksum companions ──────────────────────────────────────
data/**/*.sha256
quarantine/**/*.sha256

# ── Generated reports ───────────────────────────────────────
reports/*.html
reports/*.pdf

# ── Docker ───────────────────────────────────────────────────
.docker/
